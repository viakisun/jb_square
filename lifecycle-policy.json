{
  "rules": [
    {
      "rulePriority": 1,
      "description": "Keep all latest tagged images",
      "selection": {
        "tagStatus": "tagged",
        "tagPrefixList": ["backend-latest", "frontend-main-latest", "frontend-admin-latest"],
        "countType": "imageCountMoreThan",
        "countNumber": 999
      },
      "action": {
        "type": "expire"
      }
    },
    {
      "rulePriority": 2,
      "description": "Keep only 2 recent SHA tagged images per service",
      "selection": {
        "tagStatus": "tagged",
        "tagPrefixList": ["backend-", "frontend-main-", "frontend-admin-"],
        "countType": "imageCountMoreThan",
        "countNumber": 2
      },
      "action": {
        "type": "expire"
      }
    },
    {
      "rulePriority": 3,
      "description": "Delete untagged images after 1 day",
      "selection": {
        "tagStatus": "untagged",
        "countType": "sinceImagePushed",
        "countUnit": "days",
        "countNumber": 1
      },
      "action": {
        "type": "expire"
      }
    }
  ]
}
