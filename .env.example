# ========================================
# AWS Configuration
# ========================================
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# ========================================
# S3 Configuration for Evidence Documents
# ========================================
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_S3_REGION=ap-northeast-2

# ========================================
# AWS RDS Database Configuration
# ========================================
AWS_DB_HOST=your_rds_endpoint.rds.amazonaws.com
AWS_DB_PORT=5432
AWS_DB_NAME=your_database_name
AWS_DB_USER=postgres
AWS_DB_PASSWORD=your_database_password

# ========================================
# Flask Configuration
# ========================================
FLASK_ENV=production
FLASK_SECRET_KEY=your-production-secret-key-change-this
FLASK_PORT=5000

# ========================================
# Admin Account (Initial Setup)
# ========================================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_strong_password

# ========================================
# API Keys for Data Collection
# ========================================
# NTIS: 국가과학기술지식정보서비스
# Apply: https://www.ntis.go.kr/rndopen/api/mng/apiMain.do
NTIS_API_KEY=

# JBTP: 전북테크노파크
JBTP_API_KEY=

# BizInfo: 기업마당
# Apply: https://www.bizinfo.go.kr/web/lay1/program/S1T175C174/apiDetail.do
BIZINFO_API_KEY=

# ========================================
# Naver Maps API (Frontend only - Client ID)
# ========================================
# Naver Maps JavaScript API Client ID
# Apply: https://console.ncloud.com/naver-service/application
# Application Name: jb-square
NEXT_PUBLIC_NAVER_CLIENT_ID=

# ========================================
# Naver Cloud Platform (Backend only - Optional)
# ========================================
# NCP Geocoding API credentials (선택사항 - 현재 미사용)
# 주의: 이 키들은 절대 NEXT_PUBLIC_ 접두사를 사용하면 안됩니다
# NAVER_CLOUD_CLIENT_ID=
# NAVER_CLOUD_CLIENT_SECRET=

# ========================================
# Application Configuration (Optional)
# ========================================
# API_BASE_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:3000
# LOG_LEVEL=INFO

# Frontend API Base URL (REQUIRED for production)
# Production: /api (relative path through nginx proxy)
# Development: http://localhost:8000 (direct backend connection)
NEXT_PUBLIC_API_BASE_URL=/api

# CORS 허용 도메인 (쉼표로 구분)
# 프로덕션 도메인 + 개발 환경 포함
# 모든 서브도메인 (www, admin) 및 HTTP/HTTPS 프로토콜 포함
CORS_ALLOWED_ORIGINS=http://jb2.kr,http://jb2.co.kr,http://www.jb2.kr,http://www.jb2.co.kr,http://admin.jb2.kr,http://admin.jb2.co.kr,https://jb2.kr,https://jb2.co.kr,https://www.jb2.kr,https://www.jb2.co.kr,https://admin.jb2.kr,https://admin.jb2.co.kr,http://localhost:5173,http://localhost:5174,http://localhost:5175
